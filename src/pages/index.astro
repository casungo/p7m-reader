---
import "../styles/global.css";

const title = "Apri P7M Online – Estrai PDF, XML e immagini";
const description =
  "Apri ed estrai file P7M direttamente nel browser. Nessun upload, nessun account: il documento resta sul tuo dispositivo.";
const release = {
  version: "1.0.0",
  date: "29 luglio 2026",
  changes: [
    "Anteprima di PDF, XML e immagini",
    "Dati leggibili dei certificati",
    "Uso offline dopo la prima visita",
  ],
};
const faq = [
  {
    question: "I file vengono caricati su un server?",
    answer:
      "No. Lettura, estrazione e anteprima avvengono nel browser. Registriamo solo eventi anonimi di riuscita o errore, mai nomi o contenuti dei file.",
  },
  {
    question: "Il servizio verifica la validità legale della firma?",
    answer:
      "No. Mostra i dati leggibili dei certificati, ma non verifica integrità, revoca, marca temporale o validità legale della firma.",
  },
  {
    question: "Quali contenuti posso visualizzare?",
    answer:
      "PDF, XML, immagini PNG, JPEG e GIF. Gli altri contenuti possono essere estratti e scaricati come file binario.",
  },
  {
    question: "Funziona senza connessione?",
    answer:
      "Sì, dopo la prima visita il servizio può essere riaperto offline dallo stesso browser.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Apri P7M Online",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Qualsiasi",
      browserRequirements: "JavaScript",
      description,
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
      featureList: [
        "Estrazione locale di file P7M",
        "Anteprima di PDF, XML e immagini",
        "Supporto offline",
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map(({ question, answer }) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2447c6" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="/" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <header class="app-header">
      <a class="brand" href="/" aria-label="Apri P7M Online">
        <img src="/icon.svg" alt="" width="42" height="42" />
        <span><strong>Apri P7M Online</strong><small>Visualizza. Scarica. Semplice.</small></span>
      </a>
      <nav class="header-actions" aria-label="Progetto">
        <details class="release-menu">
          <summary>v{release.version}<span>Novità</span></summary>
          <div class="release-card">
            <strong>Versione {release.version}</strong>
            <small>{release.date}</small>
            <ul>{release.changes.map((change) => <li>{change}</li>)}</ul>
            <a href="https://github.com/casungo/apri-p7m-online/releases">Tutti i rilasci</a>
          </div>
        </details>
        <a class="header-link" href="https://github.com/casungo/apri-p7m-online" aria-label="Guarda il codice sorgente su GitHub">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.2.8-.6v-2.2c-3.4.7-4.1-1.4-4.1-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.3.1 2 1.3 2 1.3 1.1 2 3 1.4 3.6 1.1.1-.8.4-1.4.8-1.7-2.7-.3-5.6-1.4-5.6-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8-.8c1 0 2 .1 2.9.4 2.2-1.5 3.2-1.2 3.2-1.2.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.9 5.4-5.6 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z"/></svg>
          <span>Codice sorgente</span>
        </a>
        <a class="support-link" href="https://donate.casungo.top">Sostieni il progetto</a>
      </nav>
    </header>

    <main class="app-shell">
      <section class="workspace" aria-label="Visualizzatore P7M">
        <input id="file" type="file" accept=".p7m,application/pkcs7-mime" multiple />
        <section class="viewer-empty" id="drop-zone" aria-labelledby="upload-title">
          <div class="empty-layout">
            <div class="empty-content">
              <img src="/icon.svg" alt="" width="64" height="64" />
              <h2 id="upload-title">Nessun documento caricato</h2>
              <p>Apri un file P7M per visualizzare il documento contenuto.</p>
              <label for="file">Apri un file P7M</label>
              <small>Oppure trascina e rilascia qui il file</small>
            </div>
            <dl class="empty-meta">
              <div><dt>Stato firma</dt><dd>–</dd></div>
              <div><dt>Firmatari</dt><dd>–</dd></div>
              <div><dt>Validità certificato</dt><dd>–</dd></div>
            </dl>
          </div>
          <span class="empty-download" aria-disabled="true">Scarica documento</span>
        </section>
        <p id="status" role="status" aria-live="polite"></p>
        <section id="results" aria-label="File estratti"></section>
      </section>

      <aside class="seo-panel" id="guida">
        <article>
          <h1>Apri file P7M online</h1>
          <p>
            Visualizza il contenuto di un file <strong>.p7m</strong> direttamente
            nel browser. PDF, XML e immagini restano sul tuo dispositivo.
          </p>
        </article>

        <section class="quick-guide">
          <h2>Come funziona</h2>
          <ol class="guide-steps">
            <li><span>1</span><div><strong>Carica il file P7M</strong><p>Selezionalo o trascinalo dal dispositivo.</p></div></li>
            <li><span>2</span><div><strong>Visualizza il contenuto</strong><p>Apriamo localmente il documento incorporato.</p></div></li>
            <li><span>3</span><div><strong>Scarica il documento</strong><p>Salva il contenuto estratto con un clic.</p></div></li>
          </ol>
          <ul class="benefits">
            <li><strong>Privato:</strong> nessun file viene caricato.</li>
            <li><strong>Veloce:</strong> nessun account o attesa.</li>
            <li><strong>Compatibile:</strong> PDF, XML, PNG, JPEG e GIF.</li>
            <li><strong>Offline:</strong> funziona anche senza connessione.</li>
          </ul>
        </section>

        <section>
          <h2>FAQ e limitazioni</h2>
          {faq.map(({ question, answer }) => (
            <details>
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </section>

        <p class="legal-note">
          <strong>Apre il contenuto, non valida legalmente la firma.</strong>
          I dati dei certificati sono soltanto informativi.
        </p>
      </aside>
    </main>

    <template id="result-template">
      <article class="result">
        <div class="filebar">
          <div class="file-identity">
            <strong class="filename"></strong>
            <span class="file-meta"></span>
          </div>
          <div class="file-actions">
            <label for="file">Cambia file</label>
            <button class="clear" type="button">Chiudi</button>
          </div>
        </div>
        <div class="viewer-layout">
          <div class="preview"></div>
          <aside class="document-info" aria-label="Informazioni sulla firma">
            <dl>
              <div><dt>Stato firma</dt><dd>Non verificata</dd></div>
              <div><dt>Firmatari</dt><dd class="signers"></dd></div>
              <div><dt>Validità certificato</dt><dd class="certificate-validity"></dd></div>
            </dl>
            <small>Dati informativi: non costituiscono verifica della firma.</small>
          </aside>
        </div>
        <a class="download" download>Scarica documento</a>
      </article>
    </template>

    <script>
      import {
        detectP7mContent,
        extractedName,
        type P7mCertificate,
      } from "../lib/p7m";

      type WorkerReply = {
        bytes?: ArrayBuffer;
        certificates?: P7mCertificate[];
        error?: string;
      };

      const input = document.querySelector<HTMLInputElement>("#file")!;
      const dropZone = document.querySelector<HTMLElement>("#drop-zone")!;
      const status = document.querySelector<HTMLElement>("#status")!;
      const results = document.querySelector<HTMLElement>("#results")!;
      const template = document.querySelector<HTMLTemplateElement>("#result-template")!;
      const objectUrls: string[] = [];

      const track = (event: "opened" | "failed") => {
        if (navigator.onLine) navigator.sendBeacon?.(`/metrics/${event}`);
      };

      const certificateDate = new Intl.DateTimeFormat("it-IT");

      const unpackFile = (file: File) =>
        new Promise<Required<Pick<WorkerReply, "bytes" | "certificates">>>(async (resolve, reject) => {
          const worker = new Worker(
            new URL("../workers/p7m.worker.ts", import.meta.url),
            { type: "module" },
          );
          worker.addEventListener("message", ({ data }: MessageEvent<WorkerReply>) => {
            worker.terminate();
            if (data.error || !data.bytes || !data.certificates) {
              reject(new Error(data.error || "File P7M non leggibile"));
            } else {
              resolve({ bytes: data.bytes, certificates: data.certificates });
            }
          });
          worker.addEventListener("error", () => {
            worker.terminate();
            reject(new Error("Impossibile elaborare il file"));
          });
          const bytes = await file.arrayBuffer();
          worker.postMessage(bytes, [bytes]);
        });

      const renderFile = async (file: File) => {
        if (!file.name.toLowerCase().endsWith(".p7m")) {
          throw new Error("seleziona un file con estensione .p7m");
        }
        if (!file.size) throw new Error("il file è vuoto");
        const { bytes: buffer, certificates } = await unpackFile(file);
        const bytes = new Uint8Array(buffer);
        const content = detectP7mContent(bytes);
        const name = extractedName(file.name, content.ext);
        const url = URL.createObjectURL(new Blob([buffer], { type: content.type }));
        objectUrls.push(url);

        const card = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        card.querySelector<HTMLElement>(".filename")!.textContent = name;
        const size = new Intl.NumberFormat("it-IT", {
          style: "unit",
          unit: "megabyte",
          maximumFractionDigits: 1,
        }).format(file.size / 1024 / 1024);
        card.querySelector<HTMLElement>(".file-meta")!.textContent =
          `P7M · ${content.label} · ${size} · ${certificates.length} ${certificates.length === 1 ? "firmatario" : "firmatari"}`;
        const download = card.querySelector<HTMLAnchorElement>(".download")!;
        download.href = url;
        download.download = name;

        const signers = card.querySelector<HTMLElement>(".signers")!;
        signers.replaceChildren(
          ...(certificates.length
            ? certificates.map((certificate) => {
                const item = document.createElement("p");
                item.textContent = certificate.name;
                return item;
              })
            : [Object.assign(document.createElement("p"), { textContent: "Nessun certificato leggibile" })]),
        );
        const validity = card.querySelector<HTMLElement>(".certificate-validity")!;
        validity.replaceChildren(
          ...(certificates.length
            ? certificates.map((certificate) => {
                const item = document.createElement("p");
                item.textContent = `${certificateDate.format(new Date(certificate.notBefore))}–${certificateDate.format(new Date(certificate.notAfter))}`;
                return item;
              })
            : [Object.assign(document.createElement("p"), { textContent: "Non disponibile" })]),
        );

        const preview = card.querySelector<HTMLElement>(".preview")!;
        if (content.type === "application/pdf") {
          const frame = document.createElement("iframe");
          frame.src = url;
          frame.title = `Anteprima di ${name}`;
          preview.append(frame);
        } else if (content.type.startsWith("image/")) {
          const image = document.createElement("img");
          image.src = url;
          image.alt = `Anteprima di ${name}`;
          preview.append(image);
        } else if (content.type === "application/xml") {
          const code = document.createElement("pre");
          code.textContent = new TextDecoder().decode(bytes);
          preview.append(code);
        } else {
          const note = document.createElement("p");
          note.className = "no-preview";
          note.textContent = "Anteprima non disponibile. Puoi scaricare il contenuto estratto.";
          preview.append(note);
        }

        results.append(card);
        track("opened");
      };

      const friendlyError = (error: unknown) => {
        const message = error instanceof Error ? error.message : "";
        if (
          message.includes("estensione") ||
          message.includes("vuoto") ||
          message.includes("troppe firme")
        ) return message;
        if (message.includes("contenuto non trovato")) {
          return "la firma non contiene un documento incorporato";
        }
        return "non sembra un P7M valido oppure è danneggiato";
      };

      const openFiles = async (files: File[]) => {
        objectUrls.splice(0).forEach(URL.revokeObjectURL);
        results.replaceChildren();
        dropZone.hidden = true;
        status.textContent = `Apro ${files.length} file…`;

        let failures = 0;
        for (const file of files) {
          try {
            await renderFile(file);
          } catch (error) {
            failures++;
            track("failed");
            const item = document.createElement("p");
            item.className = "file-error";
            item.textContent = `${file.name}: ${friendlyError(error)}`;
            results.append(item);
          }
        }

        status.textContent = failures
          ? `${failures} ${failures === 1 ? "file non aperto" : "file non aperti"}`
          : "";
      };

      const reset = () => {
        objectUrls.splice(0).forEach(URL.revokeObjectURL);
        input.value = "";
        results.replaceChildren();
        status.textContent = "";
        dropZone.hidden = false;
      };

      input.addEventListener("change", () => input.files && openFiles([...input.files]));
      results.addEventListener("click", (event) => {
        if ((event.target as Element).closest(".clear")) reset();
      });
      dropZone.addEventListener("dragover", (event) => {
        event.preventDefault();
        dropZone.classList.add("dragging");
      });
      dropZone.addEventListener("dragleave", () => dropZone.classList.remove("dragging"));
      dropZone.addEventListener("drop", (event) => {
        event.preventDefault();
        dropZone.classList.remove("dragging");
        if (event.dataTransfer?.files.length) openFiles([...event.dataTransfer.files]);
      });

      if ("serviceWorker" in navigator) {
        addEventListener("load", () => navigator.serviceWorker.register("/service-worker.js"));
      }
    </script>
  </body>
</html>
