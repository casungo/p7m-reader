---
import "../styles/global.css";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Apri file P7M online, visualizza il contenuto e scaricalo. PDF, XML e immagini restano nel browser e non vengono mai caricati su server esterni."
    />
    <meta name="theme-color" content="#3157d5" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <title>Apri P7M Online – Visualizza e scarica file firmati</title>
  </head>
  <body>
    <main>
      <header>
        <span class="mark">P7M</span>
        <h1>Apri P7M online</h1>
        <p>Visualizza PDF, XML e immagini contenuti nei tuoi file firmati.</p>
      </header>

      <section class="upload" id="drop-zone">
        <label for="file">Scegli file .p7m</label>
        <span>oppure trascinali qui</span>
        <input id="file" type="file" accept=".p7m,application/pkcs7-mime" multiple />
        <small>Elaborazione locale, anche offline. Nessun upload.</small>
      </section>

      <p id="status" role="status" aria-live="polite"></p>
      <section id="results" aria-label="File estratti"></section>
    </main>

    <template id="result-template">
      <article class="result">
        <div class="result-head">
          <div>
            <strong class="filename"></strong>
            <span class="kind"></span>
          </div>
          <a class="download" download>Scarica</a>
        </div>
        <details class="signature">
          <summary>Informazioni sulla firma</summary>
          <div class="certificates"></div>
          <small>Metadati del certificato, non verifica di validità legale.</small>
        </details>
        <div class="preview"></div>
      </article>
    </template>

    <script>
      import {
        detectP7mContent,
        extractedName,
        unpackP7m,
        type P7mCertificate,
      } from "../lib/p7m";

      const input = document.querySelector<HTMLInputElement>("#file")!;
      const dropZone = document.querySelector<HTMLElement>("#drop-zone")!;
      const status = document.querySelector<HTMLElement>("#status")!;
      const results = document.querySelector<HTMLElement>("#results")!;
      const template = document.querySelector<HTMLTemplateElement>("#result-template")!;
      const objectUrls: string[] = [];

      const certificateText = (certificate: P7mCertificate) => {
        const name = certificate.subject.getField("CN")?.value
          ?? certificate.subject.getField("O")?.value
          ?? "Firmatario non indicato";
        const date = new Intl.DateTimeFormat("it-IT");
        return `${name} · certificato ${date.format(certificate.validity.notBefore)}–${date.format(certificate.validity.notAfter)}`;
      };

      const renderFile = async (file: File) => {
        const { bytes, certificates } = unpackP7m(new Uint8Array(await file.arrayBuffer()));
        const content = detectP7mContent(bytes);
        const name = extractedName(file.name, content.ext);
        const url = URL.createObjectURL(
          new Blob([new Uint8Array(bytes).buffer], { type: content.type }),
        );
        objectUrls.push(url);

        const card = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        card.querySelector<HTMLElement>(".filename")!.textContent = name;
        card.querySelector<HTMLElement>(".kind")!.textContent = content.label;
        const download = card.querySelector<HTMLAnchorElement>(".download")!;
        download.href = url;
        download.download = name;

        const certificateList = card.querySelector<HTMLElement>(".certificates")!;
        certificateList.replaceChildren(
          ...(certificates.length
            ? certificates.map((certificate) => {
                const item = document.createElement("p");
                item.textContent = certificateText(certificate);
                return item;
              })
            : [Object.assign(document.createElement("p"), { textContent: "Nessun certificato leggibile" })]),
        );

        const preview = card.querySelector<HTMLElement>(".preview")!;
        if (content.type === "application/pdf") {
          const frame = document.createElement("iframe");
          frame.src = url;
          frame.title = `Anteprima di ${name}`;
          preview.append(frame);
        } else if (content.type.startsWith("image/")) {
          const image = document.createElement("img");
          image.src = url;
          image.alt = `Anteprima di ${name}`;
          preview.append(image);
        } else if (content.type === "application/xml") {
          const code = document.createElement("pre");
          code.textContent = new TextDecoder().decode(bytes);
          preview.append(code);
        }

        results.append(card);
      };

      const openFiles = async (files: File[]) => {
        objectUrls.splice(0).forEach(URL.revokeObjectURL);
        results.replaceChildren();
        status.textContent = `Apro ${files.length} ${files.length === 1 ? "file" : "file"}…`;

        let failures = 0;
        for (const file of files) {
          try {
            await renderFile(file);
          } catch (error) {
            failures++;
            const message = error instanceof Error ? error.message : "file non leggibile";
            const item = document.createElement("p");
            item.className = "file-error";
            item.textContent = `${file.name}: ${message}`;
            results.append(item);
          }
        }

        status.textContent = failures ? `${failures} file non aperti` : "";
      };

      input.addEventListener("change", () => input.files && openFiles([...input.files]));
      dropZone.addEventListener("dragover", (event) => {
        event.preventDefault();
        dropZone.classList.add("dragging");
      });
      dropZone.addEventListener("dragleave", () => dropZone.classList.remove("dragging"));
      dropZone.addEventListener("drop", (event) => {
        event.preventDefault();
        dropZone.classList.remove("dragging");
        if (event.dataTransfer?.files.length) openFiles([...event.dataTransfer.files]);
      });

      if ("serviceWorker" in navigator) {
        addEventListener("load", () => navigator.serviceWorker.register("/service-worker.js"));
      }
    </script>
  </body>
</html>
