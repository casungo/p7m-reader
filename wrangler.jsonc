{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "p7m-reader",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/metrics/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
